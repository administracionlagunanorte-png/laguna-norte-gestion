generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ESQUEMA — apunta a las MISMAS tablas de Aiven
// que el sistema de escritorio condominios-cyj
// SIN @relation para evitar errores de validación.
// ============================================

model OrdenTrabajo {
  id              String   @id @default(cuid())
  otNum           String   @unique
  titulo          String
  tipo            String   @default("Correctivo")
  prioridad       String   @default("Media")
  estado          String   @default("Pendiente")
  ubicacion       String?
  fechaInicio     String?
  fechaLimite     String?
  fechaInicioReal String?
  fechaFinReal    String?
  costoEstimado   Float    @default(0)
  costoReal       Float    @default(0)
  progreso        Int      @default(0)
  descripcion     String?
  tiempoEst       Int      @default(0)
  tiempoReal      Int      @default(0)
  valorHora       Float    @default(0)
  notas           String?
  esRecurrente    Boolean  @default(false)
  formaPago       String?
  estadoAprobacion String? @default("Pendiente")
  fotosAntes      String?
  fotosDespues    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  condominioId    String?
  propiedadId     String?
  asignadoId      String?
  activoId        String?
  centroCostoId   String?

  @@index([condominioId, estado])
  @@index([estadoAprobacion])
  @@index([asignadoId])
  @@index([createdAt])
  @@index([fechaInicio])
}

model Personal {
  id            String   @id @default(cuid())
  nombre        String
  rut           String?  @unique
  cargo         String?
  contrato      String   @default("Indefinido")
  afp           String   @default("ProVida")
  salud         String   @default("Fonasa")
  mutual        String   @default("IST")
  ccaf          String?
  fechaIngreso  String?
  sueldoBase    Float    @default(0)
  movilizacion  Float    @default(0)
  colacion      Float    @default(0)
  viatico       Float    @default(0)
  asigFamiliar  Float    @default(0)
  estado        String   @default("Activo")
  email         String?
  telefono      String?
  foto          String?
  notas         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  condominioId  String?

  @@index([estado])
}

model Secuencia {
  id        String   @id @default(cuid())
  tabla     String   @unique
  prefijo   String
  ultimoNum Int      @default(0)
  padding   Int      @default(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Condominio {
  id           String   @id @default(cuid())
  nombre       String
  direccion    String?
  comuna       String?
  ciudad       String?
  rut          String?
  telefono     String?
  email        String?
  etapas       String?
  estado       String   @default("Activo")
  fechaInicio  String?
  notas        String?
  logo         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================
// MODELOS PROPIOS DE LA APP MÓVIL
// ============================================

model MovilProfile {
  id          String   @id @default(cuid())
  name        String
  password    String   @default("")
  accessCode  String   @default("")
  color       String   @default("")
  icon        String   @default("")
  workAreaIds String[] @default([])
  permissions String[] @default(["view"])
  personalId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([accessCode])
}

model MovilQrLocation {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  location    String   @default("")
  code        String   @unique
  active      Boolean  @default(true)
  createdBy   String   @default("admin")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([code])
  @@index([active])
}

model MovilQrScan {
  id           String    @id @default(cuid())
  qrLocationId String
  scannedBy    String    @default("")
  profileId    String?
  latitude     Float?
  longitude    Float?
  notes        String    @default("")
  createdAt    DateTime  @default(now())

  @@index([qrLocationId])
  @@index([scannedBy])
  @@index([createdAt])
}

// ============================================
// PATENTES VEHICULARES
// ============================================
// Cuando un guardia escanea un QR de "ENTRADA A" (ej: QR-FLAMENCOS-ENTRADA-A),
// entra en modo registro para esa ubicación. Luego escanea patentes y se
// registran como "adentro" en esa ubicación. Al escanear el QR de "SALIDA A"
// (ej: QR-FLAMENCOS-SALIDA-A), todas las patentes abiertas de esa ubicación
// se marcan como salidas.
model MovilPatente {
  id            String    @id @default(cuid())
  patente       String    // ABCD12 (siempre uppercase)
  ubicacion     String    // FLAMENCOS, BANDURRIAS, etc.
  entradaQrCode String    // QR-FLAMENCOS-ENTRADA-A (el QR que triggered la entrada)
  entradaScanId String?   // link al MovilQrScan que triggered la entrada
  entradaAt     DateTime  @default(now()) // cuándo se escaneó la patente
  salidaQrCode  String?   // QR-FLAMENCOS-SALIDA-A
  salidaScanId  String?   // link al MovilQrScan que triggered la salida
  salidaAt      DateTime? // null = todavía adentro
  scannedBy     String    @default("")
  profileId     String?
  latitude      Float?
  longitude     Float?
  notes         String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([ubicacion, salidaAt]) // query: patentes abiertas por ubicación
  @@index([patente])
  @@index([entradaAt])
  @@index([scannedBy])
}

model MovilAuditLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String
  entityName  String   @default("")
  changes     String   @default("{}")
  performedBy String   @default("admin")
  profileId   String?
  createdAt   DateTime @default(now())

  @@index([entityType])
  @@index([action])
  @@index([createdAt])
}
