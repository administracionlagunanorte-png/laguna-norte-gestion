generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model WorkOrder {
  id            String    @id
  otId          String
  activities    String[]  @default([])
  collaborators String[]  @default([])
  zoneName      String    @default("")
  description   String    @default("")
  status        String    @default("Pendiente")
  plannedDate   DateTime?
  photosBefore  String[]  @default([])
  photosAfter   String[]  @default([])
  recurringId   String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([otId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([recurringId])
  @@index([plannedDate])
}

model RecurringWorkOrder {
  id              String     @id @default(cuid())
  name            String
  activities      String[]   @default([])
  collaborators   String[]   @default([])
  zoneName        String     @default("")
  workAreaId      String
  description     String     @default("")
  frequency       String     @default("weekly")
  daysOfWeek      Int[]      @default([])
  dayOfMonth      Int?
  status          String     @default("active")
  lastGeneratedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status])
  @@index([frequency])
}

model Profile {
  id          String   @id @default(cuid())
  name        String
  password    String   @default("")
  accessCode  String   @default("")
  color       String   @default("")
  icon        String   @default("")
  workAreaIds String[] @default([])
  permissions String[] @default(["view"])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([accessCode])
}

model Counter {
  id    String @id @default("ot_counter")
  value Int    @default(0)
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String   // CREATE, UPDATE, DELETE
  entityType  String   // WorkOrder, Profile, RecurringWorkOrder, QrLocation
  entityId    String   // ID of the affected entity
  entityName  String   @default("") // Human-readable identifier (e.g., OT-0001, profile name)
  changes     String   @default("{}") // JSON string of what changed (oldValues -> newValues)
  performedBy String   @default("admin") // Who did it (profile name or "admin")
  profileId   String?  // Profile ID if done by a profile user
  createdAt   DateTime @default(now())

  @@index([entityType])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@index([performedBy])
  @@index([entityId])
}

model QrLocation {
  id          String   @id @default(cuid())
  name        String   // e.g. "Portería Principal", "Piscina 1"
  description String   @default("") // Additional details
  location    String   @default("") // e.g. "Sector A - Entrada Norte"
  code        String   @unique // Unique code embedded in QR (e.g. "QR-LOC-001")
  active      Boolean  @default(true)
  createdBy   String   @default("admin")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scans       QrScan[]

  @@index([code])
  @@index([active])
  @@index([createdAt(sort: Desc)])
}

model QrScan {
  id           String    @id @default(cuid())
  qrLocationId String    // Reference to the scanned QrLocation
  scannedBy    String    @default("") // Name of the guard who scanned
  profileId    String?   // Profile ID of the guard
  latitude     Float?    // GPS latitude at scan time
  longitude    Float?    // GPS longitude at scan time
  notes        String    @default("") // Optional notes from the guard
  createdAt    DateTime  @default(now())

  location     QrLocation @relation(fields: [qrLocationId], references: [id], onDelete: Cascade)

  @@index([qrLocationId])
  @@index([scannedBy])
  @@index([createdAt(sort: Desc)])
  @@index([profileId])
}
